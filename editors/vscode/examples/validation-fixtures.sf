package fixtures;

import "fixture-imports.sf";

message Child {
  uint8 value = 1;
}

message BrokenDefaults {
  option magic_bytes = "0x00, 300"; // EXPECT: option magic_bytes: each value must be 1–255
  option extensions_start = 99; // EXPECT: message-level extensions_start cannot be combined with oneof fields

  repeated int8 repeated_value = 1 [size=2, default=1]; // EXPECT: default is not supported on repeated field
  int8 out_of_range = 2 [default=999]; // EXPECT: default for int8
  bool invalid_bool = 3 [default=maybe]; // EXPECT: default for bool
  string too_long = 4 [size=3, default="hello"]; // EXPECT: default string exceeds size=3
  Child invalid_message = 5 [default=Child]; // EXPECT: default is not supported on message-typed field
  ImportedState valid_imported_enum = 6 [default=READY];
  ImportedState invalid_enum = 7 [default=UNKNOWN]; // EXPECT: default for enum
  uint8 typo = 8 [defualt=1]; // EXPECT: Unknown field option 'defualt'
  uint8 duplicate = 9 [size=1, size=2]; // EXPECT: Duplicate field option 'size'

  oneof payload {
    option variable = true;
    string unsized = 1; // EXPECT: String field 'unsized' requires [size=N] or [max_size=N]
    uint8 oneof_default = 2 [default=1]; // EXPECT: default is not supported inside oneof
  }
}

message BrokenOneofOptions {
  oneof payload {
    option variable = true; // EXPECT: requires parent message 'BrokenOneofOptions' to use option variable = true
    option max_size = 64; // EXPECT: max_size is only valid on non-variable oneofs
    option min_size = 128; // EXPECT: min_size must not exceed max_size
    option extensions_start = 99; // EXPECT: must equal an existing field number in oneof
    uint8 value = 1;
  }
}
