/// Example struct-frame file demonstrating syntax

package sensor_data @1;

/** Enum for sensor status */
enum SensorStatus {
  OFFLINE = 0;
  ONLINE = 1;
  ERROR = 2;
}

message SensorReading @1 [variable] {
  SensorStatus status = ONLINE;
  float value = 0.0;
  fixed_string<16> name = "unknown";
  vector<uint8, 200> data;
  uint32 timestamp;
}

message Container @2 [variable] {
  SensorReading reading;

  oneof payload [variable] {
    SensorReading sensor;
    DeviceStatus device;
  }
}

/// Wire-evolution example: v2 adds extension fields without breaking v1 receivers
message DeviceStatus @3 [magic = [0xA3, 0x7F]] {  /// Override CRC seed for schema compatibility
  /// Base fields (always on the wire)
  uint8 device_id;
  uint8 status_code;
  uint16 error_flags;

  extensions {
    // Extension fields: present in v2+ firmware; older receivers zero-fill on reception
    uint32 uptime_seconds;
    float cpu_temp;
  }
}

/// Oneof-level extensions example
message JobMessage @4 {
  bool run_immediately;

  oneof job [discriminator = field_order] {
    SensorReading sensor_job;
    extensions {
      // Extension variants: older receivers see an unknown discriminator and skip
      DeviceStatus device_job;
    }
  }
}
