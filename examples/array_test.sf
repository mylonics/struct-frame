package array_test;

enum TestEnum {
  VALUE_A = 0;
  VALUE_B = 1;
  VALUE_C = 2;
}

struct SubMessage {
  int32 id;
  string<50> name;
}

message ArrayTestMessage @100 {
  /// Fixed string (exact length)
  fixed_string<16> robot_id;

  /// Variable string (up to max length)
  string<255> description;

  /// Fixed arrays (always exact size - no count byte needed)
  array<float, 6> joint_positions;  /// Always 6 joints
  array<bool, 8> sensor_states;  /// Always 8 sensors
  array<float, 16> transformation;  /// 4x4 matrix

  /// Bounded arrays (variable count up to max - includes count byte)
  vector<fixed_string<32>, 10> joint_names;  /// Up to 10 names, each 32 chars max
  vector<int32, 100> measurements;  /// Up to 100 readings
  vector<TestEnum, 5> enum_values;  /// Up to 5 enums

  /// Nested message arrays
  vector<SubMessage, 5> messages;  /// Up to 5 submessages
}
