package generic_robot;

enum GpsFix {
  NO_FIX = 0;
  FIX_2D = 1;
  FIX_3D = 2;
  FLOAT_RTK = 3;
  FIXED_RTK = 4;
  RTK_BASE = 5;
}

struct Accuracy {
  float x_acc_mm;
  float y_acc_mm;
  GpsFix fix;
  uint8 n_sats;
  uint8 corr_age;
}

struct Point {
  double lat;
  double lon;
  float alt;
}

struct Position {
  int64 time;
  Point point;
  Accuracy acc;
}

message Reserved @0 {}

message Rtcm @1 {}

message LoraNetworkId @2 {
  uint32 mac_id;
  uint8 node_id;
}

message BaseStationStatus @3 {
  int64 sys_time;
  uint32 mac_id;
  Position position;
  float rtcm_data_rate;
  float temp;
  uint8 rssi;
}

message RobotStatus @4 {
  int64 sys_time;
  Position position;
  uint32 mac_id;
  uint8 node_id;
  float temp;
  uint8 rssi;
}

struct RobotStatusEntry {
  int32 time;
  /// RobotStatus already carries mac_id, so it is not repeated here: a flattened
  /// child field may not share a name with a field of the parent.
  RobotStatus status [flatten];
}

struct BaseStationStatusEntry {
  int32 time;
  uint32 mac_id;
  BaseStationStatus status;
}
