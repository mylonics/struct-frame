// Package ID 1. Message ids only need to be unique inside a package.
package sensor_data;

option pkgid = 1;

enum SensorType {
  TEMPERATURE = 0;
  HUMIDITY = 1;
  PRESSURE = 2;
  LIGHT = 3;
}

message SensorReading {
  option msgid = 1;                  // wire id (1 << 8) | 1 = 257
  SensorType type = 1;
  float value = 2;
  uint64 timestamp = 3;
  string sensor_id = 4 [size=16];
}

message SensorStatus {
  option msgid = 2;                  // wire id (1 << 8) | 2 = 258
  string sensor_id = 1 [size=16];
  bool online = 2;
  float battery_percent = 3;
  uint32 error_count = 4;
}
