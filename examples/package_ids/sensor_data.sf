/// Package ID 1. Message ids only need to be unique inside a package.

package sensor_data @1;

enum SensorType {
  TEMPERATURE = 0;
  HUMIDITY = 1;
  PRESSURE = 2;
  LIGHT = 3;
}

message SensorReading @1 {  /// wire id (1 << 8) | 1 = 257
  SensorType type;
  float value;
  uint64 timestamp;
  fixed_string<16> sensor_id;
}

message SensorStatus @2 {  /// wire id (1 << 8) | 2 = 258
  fixed_string<16> sensor_id;
  bool online;
  float battery_percent;
  uint32 error_count;
}
