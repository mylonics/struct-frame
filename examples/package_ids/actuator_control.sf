/// Package ID 2. msgid 1 here does not clash with sensor_data's msgid 1,
/// because the package id is part of the wire id.

package actuator_control @2;

enum ActuatorState {
  IDLE = 0;
  ACTIVE = 1;
  ERROR = 2;
  CALIBRATING = 3;
}

message ActuatorCommand @1 {  /// wire id (2 << 8) | 1 = 513
  fixed_string<16> actuator_id;
  ActuatorState desired_state;
  float target_value;
}

message ActuatorStatus @2 {  /// wire id (2 << 8) | 2 = 514
  fixed_string<16> actuator_id;
  ActuatorState current_state;
  float current_value;
  float power_consumption;
}
