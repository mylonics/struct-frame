/// Sensor messages that use the types declared in sensor_types.sf.

package sensors @2;  // same package (and pkgid) as sensor_types.sf

import "sensor_types.sf";

message SensorReading @1 {
  SensorType type;
  float value;
  SensorStatus status;
}

message SensorConfig @2 {
  SensorType type;
  uint32 sample_rate_hz;
  bool enabled;
}
