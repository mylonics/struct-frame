// Sensor messages that use the types declared in sensor_types.sf.
package sensors;

option pkgid = 2;  // same package (and pkgid) as sensor_types.sf

import "sensor_types.sf";

message SensorReading {
  option msgid = 1;
  SensorType type = 1;
  float value = 2;
  SensorStatus status = 3;
}

message SensorConfig {
  option msgid = 2;
  SensorType type = 1;
  uint32 sample_rate_hz = 2;
  bool enabled = 3;
}
