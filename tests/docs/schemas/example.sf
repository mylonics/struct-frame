/// Schema behind the examples in basic-usage/language-examples.mdx and the SDK pages
/// (package `example`); doc samples compile against it.

package example;

message Status @1 {
  uint32 id;
  float value;
}

message SensorData @2 {
  vector<float, 10> readings;
}

struct Position {
  double lat;
  double lon;
}

message Vehicle @3 {
  uint32 id;
  Position pos;
}
