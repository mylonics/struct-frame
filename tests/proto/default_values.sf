/// Fixture for schema-defined field default values ([default = ...]).
/// Covers every supported default type (integers, bool, float/double, enum,
/// fixed/bounded string, bytes) plus a control message with no defaults at
/// all and a nested-message field whose own defaults must apply recursively.

package default_values;

enum Mode {
  IDLE = 0;
  ACTIVE = 1;
  ERROR = 2;
}

struct Inner {
  uint8 inner_value = 7;
}

message DefaultsMessage @1 {
  uint8 u8_val = 200;
  int8 i8_val = -100;
  uint16 u16_val = 40000;
  int16 i16_val = -1000;
  uint32 u32_val = 3000000000;
  int32 i32_val = -2000000;
  uint64 u64_val = 10000000000;
  int64 i64_val = -10000000000;
  bool bool_val = true;
  float float_val = 1.5;
  double double_val = 3.14159;
  Mode mode_val = ACTIVE;
  fixed_string<16> fixed_str = "device";
  string<32> bound_str = "hello world";
  fixed_bytes<4> fixed_bytes = "ab";

  /// No default: must remain the ordinary zero/empty value.
  uint32 plain_val;

  /// No default of its own, but Inner's own field has one -- must recurse.
  Inner nested;
}

/// Control message: no defaults anywhere. Must generate/behave identically
/// to how it would have before this feature existed.
message NoDefaultsMessage @2 {
  uint32 value;
  bool flag;
  fixed_string<8> name;
}
