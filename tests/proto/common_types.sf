// Common types that can be imported by other proto files
// Note: No pkgid defined here - will inherit from importing file
package common_types;

enum Status {
  IDLE = 0;
  ACTIVE = 1;
  ERROR = 2;
}

// msgid 100: this package inherits its importer's pkgid, so its ids share the
// importer's id space. 1 would collide with pkg_test_messages.PackageTestMessage.
message Timestamp {
  option msgid = 100;
  uint64 seconds = 1;
  uint32 nanoseconds = 2;
}
