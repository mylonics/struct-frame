/// Code-generation regression fixture for trimmed oneofs: variants that are
/// fixed strings, that declare a zero-valued default, or that contain a
/// nested oneof (named C++ union) must still compile and decode.

package trimmed_union_codegen;

struct ZeroDef {
  uint32 a = 0;
}

struct Inner {
  uint8 b = 7;
}

struct Mid {
  oneof m [discriminator = field_order] {
    Inner i;
    uint8 k;
  }
}

message Tagged @1 [variable] {
  uint8 x;
  oneof payload [discriminator = field_order] {
    fixed_string<16> name;
    uint32 code;
  }
}

message Holder @2 [variable] {
  uint8 x;
  oneof u [discriminator = field_order] {
    ZeroDef z;
    uint32 s;
  }
}

message Outer @3 {
  oneof o [discriminator = field_order] {
    Mid mid;
    uint8 q;
  }
}
