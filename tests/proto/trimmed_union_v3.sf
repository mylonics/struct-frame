/// Trimmed-union wire-evolution fixture, schema version 3.
/// A variable envelope carrying a trimmed oneof (min_size = 60). Each version
/// extends ScanTaskCommand via `extensions_start`; see test_trimmed_union_evolution.py.

package trimmed_union_v3;

enum ActionMode {
  KEEP_CURRENT = 0;
  DISABLE = 1;
  ENABLE = 2;
}

struct WarmupConfig {
  ActionMode mode;
  double duration_sec;
  uint8 stage_id;
}

struct ScanTaskCommand {
  uint8 channel_mask;
  uint32 step_count;
  float start_level;
  float end_level;
  float rate_hz;
  array<uint8, 32> reserved;
  uint8 request_id;

  extensions {
    uint8 window_begin_pct = 80;
    uint8 window_end_pct = 100;
    WarmupConfig warmup;
  }
}

struct BulkConfigCommand {
  array<uint8, 353> table_bytes;
}

message TaskEnvelope @100 [variable, envelope] {
  bool execute_now;
  oneof task [discriminator = field_order, min_size = 60] {
    ScanTaskCommand scan_task;
    BulkConfigCommand bulk_config;
  }
}

struct TinyDefaultCommand {
  uint32 prefix;
  uint32 inherited_value = 80;
}

struct TinyZeroCommand {
  uint32 prefix;

  extensions {
    uint32 extra;
  }
}

message TinyEnvelope @101 [variable] {
  oneof command [discriminator = field_order, min_size = 4] {
    TinyDefaultCommand with_default;
    TinyZeroCommand zero_default;
  }
}

message TinyUnknownEnvelope @102 [variable] {
  oneof command [discriminator = field_order, min_size = 4] {
    TinyDefaultCommand command;
  }
}
