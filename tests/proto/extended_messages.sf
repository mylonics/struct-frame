// Extended test messages for struct-frame code generation framework
// Tests for message IDs > 255 (require extended profiles with pkg_id)
// Also tests for extended payloads > 255 bytes (require 2-byte length field)
//
// These messages are only compatible with extended profiles:
// - profile_bulk (BasicExtended): supports extended msg_id and extended payload
// - profile_network (BasicExtendedMultiSystemStream): supports extended msg_id and extended payload
package extended_test;

// ============================================================================
// Extended Message ID Tests (msgid > 255)
// Three representative IDs cover the full range: boundary (256), mid (1000), high (4000).
// ============================================================================

// Message with ID 256 - tests minimum extended ID (just above 255)
message ExtendedIdMessage10 {
  option msgid = 256;
  
  uint16 small_value = 1;
  string short_text = 2 [size=16];
  bool flag = 3;
}

// Message with ID 1000 - tests mid-range extended ID
message ExtendedIdMessage2 {
  option msgid = 1000;
  
  int32 sensor_id = 1;
  double reading = 2;
  uint16 status_code = 3;
  string description = 4 [max_size=64];
}

// Message with ID 4000 - tests high extended ID with 64-bit fields
message ExtendedIdMessage9 {
  option msgid = 4000;
  
  int64 big_number = 1;
  uint64 big_unsigned = 2;
  double precision_value = 3;
}

// ============================================================================
// Extended Payload Tests (payload > 255 bytes)
// These require profiles with 2-byte length field
// ============================================================================

// Large message with payload > 255 bytes (fixed arrays: 64 floats = 256 bytes)
message LargePayloadMessage1 {
  option msgid = 800;
  
  repeated float sensor_readings = 1 [size=64];     // 64 * 4 = 256 bytes
  uint32 reading_count = 2;
  int64 timestamp = 3;
  string device_name = 4 [size=32];
}

// Large message with fixed array of 280 bytes
message LargePayloadMessage2 {
  option msgid = 801;
  
  repeated uint8 large_data = 1 [size=280];
}

// ============================================================================
// Variable Length Message Tests for Extended IDs (msgid: 802)
// ============================================================================

// Variable message with extended ID and single bounded array (msgid: 802)
message ExtendedVariableSingleArray {
  option msgid = 802;
  option variable = true;

  uint64 timestamp = 1;
  repeated uint8 telemetry_data = 2 [max_size=250];  // Up to 250 bytes
  uint32 crc = 3;
}

// Variable message with bounded fields whose max_size > 255, forcing 2-byte
// count/length prefixes in the variable encoding. Regression cover for the
// encoder/decoder/serialized_size prefix-width agreement: a 1-byte read on a
// 2-byte prefix corrupts every following field.
message ExtendedVariableLargeArray {
  option msgid = 803;
  option variable = true;

  uint32 id = 1;
  repeated uint8 big_telemetry = 2 [max_size=300];   // >255 -> 2-byte count prefix
  string big_label = 3 [max_size=300];               // >255 -> 2-byte length prefix
  uint16 trailer = 4;
}

// Fixed-size message carrying a string array whose max_size > 255. The count
// prefix is 2 bytes here too, and the fixed pack/unpack path must agree with
// it: writing a 1-byte count shifts every following field by one and does not
// even compile in languages whose count field is a 16-bit type.
message ExtendedFixedStringArray {
  option msgid = 804;

  uint32 id = 1;
  repeated string labels = 2 [max_size=300, element_size=4];  // >255 -> 2-byte count prefix
  uint16 trailer = 3;
}

// Variable message carrying string arrays, at both prefix widths. Exercises
// the variable-encoding path for repeated strings, which is distinct from the
// primitive-array and single-string paths next to it.
message ExtendedVariableStringArray {
  option msgid = 805;
  option variable = true;

  uint32 id = 1;
  repeated string tags = 2 [max_size=4, element_size=8];       // 1-byte count prefix
  repeated string big_tags = 3 [max_size=300, element_size=4];  // >255 -> 2-byte count prefix
  uint16 trailer = 4;
}

// A >255 bounded array as the *last* field. The copy cap in the fixed-size
// serializer is derived from the field size minus its count prefix; getting
// that prefix width wrong writes one byte past the end of the message buffer
// instead of harmlessly into the next field, where a following field's own
// write would paper over it.
message ExtendedTrailingLargeArray {
  option msgid = 806;

  uint32 id = 1;
  repeated uint8 payload = 2 [max_size=300];  // >255 -> 2-byte count prefix, last field
}
