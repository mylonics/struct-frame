<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <!-- Only the network transports whose dependencies ship with .NET. The WebSocket transport
         needs the optional NetCoreServer package and the serial transport needs System.IO.Ports. -->
    <Compile Include="..\..\..\src\struct_frame\boilerplate\csharp\Framework\Sdk\Transport.cs" />
    <Compile Include="..\..\..\src\struct_frame\boilerplate\csharp\Framework\Sdk\Transports\TcpTransport.cs" />
    <Compile Include="..\..\..\src\struct_frame\boilerplate\csharp\Framework\Sdk\Transports\UdpTransport.cs" />
  </ItemGroup>
</Project>
