<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <!-- The runtime sources are compiled in directly; the SDK's Sdk/ folder is not needed. -->
    <Compile Include="..\..\..\..\src\struct_frame\boilerplate\csharp\Framework\Framing\**\*.cs" />
    <Compile Include="..\..\..\..\src\struct_frame\boilerplate\csharp\Framework\Profiles\**\*.cs" />
    <Compile Include="..\..\..\..\src\struct_frame\boilerplate\csharp\Framework\Types\**\*.cs" />
  </ItemGroup>
</Project>
